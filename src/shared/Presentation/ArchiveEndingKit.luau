local list=definitions[id];if not list then return nil end
local m=Instance.new("Model");m.Name="ArchiveEnding_"..id;m.WorldPivot=CFrame.identity;m:SetAttribute("Ending",id)
for _,d in ipairs(list)do local p=Instance.new("Part");p.Name=d[1];p.Size=d[2];p.CFrame=CFrame.new(d[3])*CFrame.Angles(0,0,math.rad(d[5]));p.Color=d[4];p.Material=Enum.Material.SmoothPlastic;p.Anchored=true;p.CanCollide=false;p.CanQuery=false;p.CanTouch=false;p.TopSurface=Enum.SurfaceType.Smooth;p.BottomSurface=Enum.SurfaceType.Smooth;p.Parent=m end
return m
end

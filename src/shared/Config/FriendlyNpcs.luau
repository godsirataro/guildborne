--!strict
-- Conversation content only; these townspeople do not grant items or unlock paid land.
export type Entry={name:string,nameTh:string,role:string,roleTh:string,x:number,z:number,en:string,th:string,homeCity:string?}
local entries:{[string]:Entry}={
    host_crownford={name="Archivist Iven",nameTh="ไอเวน ผู้ดูแลบันทึก",role="Crownford welcome guide",roleTh="ผู้ต้อนรับคราวน์ฟอร์ด",x=20,z=-3988,
        en="Welcome to Crownford. The clock gate reminds us that a promise has a time as well as a name. Elian's charter opens our streets to your guild. The map marks our landmark and both return portals. Our market and tavern share trading and recruitment services with Central City; your forge and building work remain on your own island.",
        th="ยินดีต้อนรับสู่คราวน์ฟอร์ด ประตูนาฬิกาเตือนเราว่าคำสัญญามีทั้งเวลาและชื่อผู้ให้ กฎบัตรของเอเลียนเปิดทางให้กิลด์ของเจ้า แผนที่บอกที่ตั้งสถานที่สำคัญและประตูเดินทางกลับทั้งสองแห่ง ตลาดและโรงเตี๊ยมที่นี่ใช้บริการค้าและรับสมัครร่วมกับเมืองรวม ส่วนโรงตีเหล็กและงานก่อสร้างอยู่บนเกาะของเจ้า"},
    host_sylvaris={name="Gardener Leth",nameTh="เลธ ผู้ดูแลสวน",role="Sylvaris welcome guide",roleTh="ผู้ต้อนรับซิลวาริส",x=420,z=-3988,
        en="Vaela told us you gather with care. Sylvaris keeps room between its gardens so roots and travellers can both find a way through. Our council tree stands beyond the promenade. Use your map to find it, or either return portal. Bring your crafting supplies home to your guild island when you are ready.",
        th="เวลาบอกว่าเจ้าเก็บของจากป่าอย่างใส่ใจ ซิลวาริสเว้นช่องระหว่างสวนให้ทั้งรากไม้และนักเดินทางผ่านได้ ต้นไม้สภาอยู่ปลายทางเดิน เปิดแผนที่เพื่อหาเส้นทางไปชม หรือไปประตูเดินทางกลับ เมื่อพร้อมแล้วนำวัตถุดิบกลับไปสร้างของที่เกาะกิลด์ของเจ้าได้เลย"},
    host_deepforge={name="Foreman Durn",nameTh="เดิร์น หัวหน้าช่าง",role="Deepforge welcome guide",roleTh="ผู้ต้อนรับดีปฟอร์จ",x=820,z=-3988,
        en="Borin trusts work that can be checked twice. That is how we build in Deepforge: inspect the tool, clear the walkway, and leave the next shift a sound forge. Our grand forge is the city's landmark. Your own crafting station is on your guild island; the nearby guild portal takes you home.",
        th="บอรินเชื่อมั่นในงานที่ตรวจซ้ำได้ ชาวดีปฟอร์จจึงตรวจเครื่องมือ เปิดทางเดินให้โล่ง และส่งต่อโรงตีเหล็กที่พร้อมให้คนผลัดถัดไป เตาหลอมใหญ่เป็นสถานที่สำคัญของเมือง ส่วนโต๊ะสร้างของของเจ้าอยู่บนเกาะกิลด์ ประตูกิลด์ใกล้ทางเข้าพากลับบ้านได้"},
    host_astralis={name="Observer Tavi",nameTh="ทาวี ผู้สังเกตการณ์",role="Astralis welcome guide",roleTh="ผู้ต้อนรับแอสตราลิส",x=1220,z=-3988,
        en="Nyra maps the way home before she names a new discovery. We follow that custom in Astralis. The observatory marks the far end of the diamond walk; the two return portals stand near the arrival court. A bright idea is better when everyone can return to share it.",
        th="นีราวาดทางกลับบ้านก่อนตั้งชื่อสิ่งที่ค้นพบใหม่ ชาวแอสตราลิสทำตามธรรมเนียมนั้น หอดูดาวอยู่สุดทางเดินรูปเพชร ส่วนประตูเดินทางกลับทั้งสองอยู่ใกล้ลานมาถึง ความคิดที่ดีจะมีค่าขึ้นเมื่อทุกคนกลับมาแบ่งปันกันได้"},
    host_crosshaven={name="Dockkeeper Nessa",nameTh="เนสซา ผู้ดูแลท่า",role="Crosshaven welcome guide",roleTh="ผู้ต้อนรับครอสเฮเวน",x=1620,z=-3988,
        en="Sela's crews have a dry place for their cargo thanks to neighbours who keep their promises. Crosshaven welcomes every homeland. Walk the harbor loop to our charter pavilion, then use the map for your return portal. The Exchange and recruitment desks here share the same services as Central City.",
        th="ลูกเรือของเซลามีที่เก็บสินค้าแห้ง ๆ เพราะเพื่อนบ้านรักษาคำสัญญา ครอสเฮเวนต้อนรับคนจากทุกถิ่น เดินตามทางรอบท่าไปชมศาลากฎบัตร แล้วเปิดแผนที่เพื่อหาประตูกลับ ตลาดแลกเปลี่ยนและจุดรับสมัครที่นี่ใช้บริการร่วมกับเมืองรวม"},
    host_ironroot={name="Hearthkeeper Ugra",nameTh="อูกรา ผู้ดูแลเตาผิง",role="Ironroot welcome guide",roleTh="ผู้ต้อนรับไอรอนรูท",x=2020,z=-3988,
        en="Roka says you helped fill the community pot. Then you already know a little of Ironroot: strength is making room at the table. Our feast hall stands at the end of the shared lanes. Orcs and our neighbours meet there as friends. The map marks the hall and the portals back to Central City or your guild island.",
        th="โรกาบอกว่าเจ้าช่วยเติมหม้ออาหารส่วนรวม เจ้าจึงรู้จักไอรอนรูทบ้างแล้ว ความเข้มแข็งคือการเว้นที่ให้คนอื่นร่วมโต๊ะ หอเลี้ยงอาหารอยู่สุดทางเดินชุมชน ชาวออร์คและเพื่อนบ้านมาพบกันในฐานะสหาย แผนที่บอกที่ตั้งหอและประตูกลับเมืองรวมหรือเกาะกิลด์ของเจ้า"},
    marshal_elian={name="Marshal Elian",nameTh="จอมพลเอเลียน",role="Crownford envoy",roleTh="ทูตคราวน์ฟอร์ด",x=-70,z=-1090,homeCity="Crownford",
        en="A charter matters when it protects the people behind its seal. I am visiting from Crownford to help new guilds find their footing. Show me that your island is a place you return to, not just a name on paper.",
        th="กฎบัตรมีค่าก็ต่อเมื่อคุ้มครองผู้คนใต้ตรานั้น ข้ามาจากคราวน์ฟอร์ดเพื่อช่วยกิลด์ใหม่ให้ตั้งตัวได้ แสดงให้ข้าเห็นว่าเกาะของเจ้าคือบ้านที่กลับไปหา ไม่ใช่เพียงชื่อบนกระดาษ"},
    arborist_vaela={name="Arborist Vaela",nameTh="เวลา ผู้ดูแลพฤกษา",role="Sylvaris envoy",roleTh="ทูตซิลวาริส",x=260,z=-1088,homeCity="Sylvaris",
        en="Sylvaris grows by leaving room for the next seedling. I am studying Greenwood plants with Mogra. Gather gently at the herb patch, keep what you need, and tell me what the forest taught you.",
        th="ซิลวาริสเติบโตได้เพราะเราเว้นที่ให้ต้นกล้ารุ่นต่อไป ข้ากำลังศึกษาพืชกรีนวูดกับโมกรา เก็บสมุนไพรอย่างถนอม เก็บของที่จำเป็นไว้ แล้วกลับมาเล่าว่าป่าสอนอะไรเจ้า"},
    smith_borin={name="Smith Borin",nameTh="ช่างบอริน",role="Deepforge envoy",roleTh="ทูตดีปฟอร์จ",x=370,z=-958,homeCity="Deepforge",
        en="Deepforge's best work is work that lasts. Rukk has the patience of a fine smith already. Practise two ingots in your guild forge; they remain yours, and every sound casting is one less wasted load of ore.",
        th="งานที่ดีที่สุดของดีปฟอร์จคืองานที่ใช้ได้นาน รุกค์มีความอดทนของช่างฝีมืออยู่แล้ว ลองหลอมแท่งเหล็กสองชิ้นที่โรงตีเหล็กของกิลด์ ของยังเป็นของเจ้า และทุกชิ้นที่หลอมสำเร็จช่วยลดแร่ที่สูญเปล่า"},
    cartographer_nyra={name="Cartographer Nyra",nameTh="นีรา นักทำแผนที่",role="Astralis envoy",roleTh="ทูตแอสทราลิส",x=-42,z=-1460,homeCity="Astralis",
        en="A useful map marks a safe way home as carefully as a discovery. I came from Astralis to compare the Ashen stone seams. Visit the marked outcrop and return with your observations; keep the stone for your guild.",
        th="แผนที่ที่ดีต้องบอกทางกลับบ้านอย่างปลอดภัยพอ ๆ กับทางสู่การค้นพบ ข้ามาจากแอสทราลิสเพื่อเทียบแนวหินแอเชน ไปสำรวจโขดหินที่ทำเครื่องหมายแล้วกลับมาเล่าให้ฟัง เก็บหินไว้ใช้ในกิลด์ของเจ้าได้เลย"},
    harbormaster_sela={name="Harbormaster Sela",nameTh="เซลา นายท่า",role="Crosshaven envoy",roleTh="ทูตครอสเฮเวน",x=305,z=-1052,homeCity="Crosshaven",
        en="Crosshaven is built on promises kept between strangers. Our cargo shelter needs a few sound boards before the next rain. Deliver the timber here and I will see it shared among every crew, whatever their homeland.",
        th="ครอสเฮเวนตั้งอยู่บนคำสัญญาที่คนแปลกหน้ารักษาต่อกัน ที่พักสินค้าต้องการไม้แข็งแรงก่อนฝนรอบหน้า นำไม้มาส่งที่นี่ ข้าจะดูแลให้ทุกลูกเรือได้ใช้ร่วมกัน ไม่ว่ามาจากบ้านเมืองใด"},
    steward_roka={name="Steward Roka",nameTh="โรกา ผู้ดูแลชุมชน",role="Ironroot envoy",roleTh="ทูตไอรอนรูท",x=-102,z=-856,homeCity="Ironroot",
        en="Borga says you know the value of a warm welcome. In Ironroot, a shared meal is how neighbours become friends. Bring a few herbs for our community pot; humans, elves, dwarves and Orcs all have a seat.",
        th="บอร์กาบอกว่าเจ้ารู้คุณค่าของการต้อนรับ ที่ไอรอนรูท อาหารหม้อเดียวกันทำให้เพื่อนบ้านกลายเป็นสหาย นำสมุนไพรมาช่วยปรุงหม้อส่วนรวมสักหน่อย มนุษย์ เอลฟ์ คนแคระ และออร์ค ต่างมีที่นั่งที่นี่"},
    borga={name="Borga",nameTh="บอร์กา",role="Innkeeper",roleTh="เจ้าของโรงเตี๊ยม",x=-150,z=-837,
        en="A warm hearth has room for every traveller. I came from Ironroot to share Orc cooking with this city. Meet the Expedition Master by the notice board when your party is ready for work.",
        th="ข้างเตาผิงมีที่ว่างสำหรับนักเดินทางทุกคน ข้ามาจากไอรอนรูทเพื่อแบ่งปันอาหารของชาวออร์คให้เมืองนี้ เมื่อจัดปาร์ตี้พร้อมแล้ว ลองไปคุยกับผู้ดูแลการเดินทางข้างกระดานประกาศดูสิ"},
    mogra={name="Mogra",nameTh="โมกรา",role="Herbalist",roleTh="หมอสมุนไพร",x=218,z=-1034,
        en="The forest teaches patience. My family gathers herbs, and I study how to turn them into medicine. Mira nearby can tell you which supplies the city needs. Keep a few herbs for your guild too.",
        th="ป่าสอนให้เรารู้จักอดทน ครอบครัวข้าเก็บสมุนไพร ส่วนข้าศึกษาวิธีปรุงยา มิราที่อยู่ใกล้ ๆ บอกได้ว่าเมืองกำลังต้องการเสบียงอะไร อย่าลืมเก็บสมุนไพรไว้ให้กิลด์ของเจ้าด้วยนะ"},
    rukk={name="Rukk",nameTh="รุกค์",role="Apprentice smith",roleTh="ช่างตีเหล็กฝึกหัด",x=404,z=-990,
        en="One day I will forge a shield worthy of my teacher. Today I practise straight hammer blows! Check your equipment before an expedition; a prepared guild brings every companion home.",
        th="สักวันข้าจะตีโล่ให้คู่ควรกับอาจารย์ วันนี้ขอฝึกลงค้อนให้ตรงก่อน! ตรวจอุปกรณ์ก่อนออกเดินทางเสมอ กิลด์ที่เตรียมพร้อมย่อมพาสหายกลับบ้านได้ครบทุกคน"},
    ghar={name="Ghar",nameTh="การ์",role="Veteran mercenary",roleTh="ทหารรับจ้างอาวุโส",x=39,z=-1508,
        en="This shield has guarded caravans of humans, elves, dwarves and Orcs alike. Judge a companion by their deeds. Keep your party together, and watch an enemy's wind-up before committing to an attack.",
        th="โล่นี้เคยคุ้มกันกองคาราวานของมนุษย์ เอลฟ์ คนแคระ และออร์คเหมือนกัน จงตัดสินสหายจากการกระทำ รักษาระยะกับปาร์ตี้ไว้ และดูจังหวะเตรียมโจมตีของศัตรูก่อนเข้าปะทะ"},
}
return entries

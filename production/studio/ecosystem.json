      "paths": [
        "tools/agentic/mcp_probe.py",
        "tools/agentic/studio_mcp_preflight.py"
      ],
      "reason": "Live tool discovery and target identity required; executable or listed tool alone is not successful invocation."
    },
    {
      "id": "blender",
      "decision": "USE_EXISTING",
      "paths": [
        "tools/agentic/blender_job.py",
        "tools/agentic/blender_audit.py"
      ],
      "reason": "Reviewed local Blender scripts remain fallback when live MCP handshake fails."
    },
    {
      "id": "ci",
      "decision": "USE_EXISTING",
      "paths": [
        ".github/workflows/agentic-production.yml"
      ],
      "reason": "Existing credential-free checks and separate Windows game regression; no automatic publish."
    },
    {
      "id": "host-roblox-skills",
      "decision": "OPTIONAL",
      "paths": [],
      "reason": "Use installed host platform skills on demand; no copied skill pack or automatic installer."
    },
    {
      "id": "wally-pesde",
      "decision": "DEFER",
      "paths": [],
      "reason": "No runtime dependency need established; keep existing zero-third-party-runtime-dependency architecture."
    },
    {
      "id": "selene-stylua-lune",
      "decision": "DEFER",
      "paths": [],
      "reason": "Add only for a demonstrated gap with reviewed pin/config and staged formatting; do not rewrite the whole existing codebase."
    },
    {
      "id": "fusion-react",
      "decision": "KEEP_CUSTOM",
      "paths": [
        "src/client/UI/SliceUI.luau"
      ],
      "reason": "Reuse native UI adapters; migration requires a distinct scoped decision."
    },
    {
      "id": "profilestore",
      "decision": "KEEP_CUSTOM",
      "paths": [
        "src/server/Services/PlayerDataService.luau",
        "src/server/Persistence/RobloxStore.luau",
        "src/server/Persistence/MarketCloud.luau"
      ],
      "reason": "Preserve existing sessions, migration compatibility, fenced market receipts/recovery."
    },
    {
      "id": "matter-ecs",
      "decision": "DEFER",
      "paths": [],
      "reason": "Profile HeroService/NPC cost first; no traffic-system transplantation."
    },
    {
      "id": "paid-generators-open-cloud",
      "decision": "DEFER",
      "paths": [],

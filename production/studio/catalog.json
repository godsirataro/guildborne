      "id": "source-contract",
      "title": "Source, role and dependency contract"
    },
    {
      "environment": "local",
      "evidence": "Run current tools/validate.ps1 and relevant Python checks on candidate; retain invocation/raw streams. Historical counts and fixtures do not replace game baseline.",
      "id": "current-regression",
      "title": "Fresh game and tooling regression"
    },
    {
      "environment": "local",
      "evidence": "Retain source hashes, reviewed/declarative rights and original IDs. Runtime IDs remain null until real import; asset counts are not accepted output.",
      "id": "provenance",
      "title": "Original source and rights trail"
    },
    {
      "environment": "blender",
      "evidence": "Record verified Blender session/version, source/export hashes and evaluated topology/rig/fit/contact metrics. File generation alone is insufficient.",
      "id": "blender-validation",
      "title": "Actual Blender geometry and motion"

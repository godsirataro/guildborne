    {
      "environment": "image",
      "evidence": "Inspect pixels/alpha/margins/intended size with provenance; distinguish preview from final art and later import.",
      "id": "image-validation",
      "title": "Actual image alpha/readability"
    },
    {
      "environment": "audio",
      "evidence": "Record owned/licensed masters, required provider authorization, cue IDs and actual sync/mix/listening. Missing provider or files leaves pending.",
      "id": "audio-validation",
      "title": "Actual masters and listening"
    },
    {
      "environment": "studio",
      "evidence": "Identify actual Studio/build; retain real import/playtest Output and screenshots. Generated files or fixture IPC cannot imply imported IDs or acceptance.",
      "id": "studio-integration",
      "title": "Verified import and player test"
    },
    {
      "environment": "studio",
      "evidence": "Use actual two/four clients on identified Studio server and up to twenty companion scenarios. Local multiplayer does not pass distinct-live-server acceptance.",
      "id": "multiplayer",
      "title": "Real local client isolation"
    },
    {
      "environment": "device",
      "evidence": "Record real device/input identity, touch/gameplay, duration/samples and memory/thermal observations. Emulators and injected mouse cannot pass.",
      "id": "physical-device",
      "title": "Physical Android/iOS acceptance"
    },
    {
      "environment": "cross_server",
      "evidence": "Requires scoped private platform approval, distinct nonempty live JobIds, real clients, durable settlement/recovery and zero conservation error.",
      "id": "cross-server",
      "title": "Distinct live settlement/recovery"
    },
    {
      "environment": "local",
      "evidence": "Different worker reviews source, invocation and hashes; composed local packets remain REVIEW until validated. Names are not identity authentication.",
      "id": "independent-review",
      "title": "Different reviewer inspects change"
    },
    {
      "environment": "local",
      "evidence": "External human art/feel/UAT approval and separately scoped release authorization required. Local tooling cannot certify or auto-merge/publish.",
      "id": "human-release",
      "title": "External art/UAT/release decision"
    }

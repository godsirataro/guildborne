--!strict
return function(test:any,eq:any)
 local Util=require("../src/shared/Util/TableUtil")
 local Content=require("../src/server/Config/Content")
 local Config=require("../src/server/Config/LaunchRewards")
 local Economy=require("../src/server/Services/EconomyService")(Content,Util)
 local Make=require("../src/server/Systems/LaunchRewards")
 local S=Make(Content,Util,Economy,Config)
 local function data():any return {inventory={stacks={},equipment={}},progression={campaign={claimed=11}}}end
 local function apply(d:any,a:string,args:any,n:number):any return S.apply(d,a,args,n,function()end)end
 test("daily UTC boundary and rollback cannot duplicate claims",function()
  local d=data();eq(apply(d,"ClaimDailyReward",{},86399),nil);eq(d.inventory.stacks.herb,2)
  eq(apply(d,"ClaimDailyReward",{},86399),"DailyAlreadyClaimed")
  eq(apply(d,"ClaimDailyReward",{},86400),nil);eq(d.inventory.stacks.timber,2)
  eq(apply(d,"ClaimDailyReward",{},1),"DailyAlreadyClaimed");eq(d.launchRewards.daily.claims,2)
 end)
 test("skipped days preserve cycle and day seven repeats without reset",function()
  local d=data();for i=1,8 do eq(apply(d,"ClaimDailyReward",{},i*86400*3),nil)end
  eq(d.launchRewards.daily.claims,8);eq(d.inventory.stacks.herb,7);eq(d.inventory.stacks.iron_ingot,1);eq(S.validate(d.launchRewards),true)
 end)
 test("full inventory leaves daily receipt and state unchanged",function()
  local d=data();d.inventory.stacks.herb=Content.Limits.Stack;local old=Util.copy(d)
  eq(apply(d,"ClaimDailyReward",{},86400),"InventoryFull");eq(d,old)
 end)
 test("season uses persisted chapter count and claims each track once",function()
  local d=data();d.progression.campaign.claimed=5
  local a={seasonId=Config.SeasonId,tier=1,track="free"}
  eq(apply(d,"ClaimSeasonReward",a,0),"SeasonTierLocked");d.progression.campaign.claimed=6
  eq(apply(d,"ClaimSeasonReward",a,0),nil);eq(apply(d,"ClaimSeasonReward",a,0),"SeasonAlreadyClaimed")
  a.track="premium";eq(apply(d,"ClaimSeasonReward",a,0),"PremiumRequired")
  d.launchRewards.season.premiumOwned=true;eq(apply(d,"ClaimSeasonReward",a,0),"PremiumRequired")
  local c=Util.copy(Config);c.PremiumEnabled=true;local enabled=Make(Content,Util,Economy,c)
  eq(enabled.apply(d,"ClaimSeasonReward",a,0,function()end),nil);eq(enabled.apply(d,"ClaimSeasonReward",a,0,function()end),"SeasonAlreadyClaimed")
  eq(d.inventory.stacks.herb,4)
 end)
 test("reward validation rejects injected fields and malformed receipts",function()
  local d=data();eq(apply(d,"ClaimDailyReward",{day=1},0),"InvalidRequest")
  eq(apply(d,"ClaimDailyReward",{},0/0),"InvalidRewardTime")
  eq(apply(d,"ClaimSeasonReward",{seasonId="other",tier=1,track="free"},0),"InvalidSeasonReward")
  eq(apply(d,"ClaimSeasonReward",{seasonId=Config.SeasonId,tier=1,track="free",progress=6},0),"InvalidSeasonReward")
  local s=S.new();s.season.premium["1"]=true;eq(S.validate(s),false)
  s=S.new();s.daily.lastClaimDay=0;eq(S.validate(s),false)
  s=S.new();s.season.free["01"]=true;eq(S.validate(s),false)
  s=S.new();s.season.free["7"]=true;eq(S.validate(s),false)
  d.launchRewards={};eq(S.migrate(d),false);eq(S.view(d,0).available,false)
 end)
 test("additive migration and projection preserve isolation",function()
  local d=data();local old=Util.copy(d);eq(S.validate(nil),true);eq(S.migrate(d),true)
  local stored=Util.copy(d.launchRewards);eq(S.migrate(d),true);eq(d.launchRewards,stored)
  eq(d.inventory,old.inventory);eq(d.progression,old.progression)
  local view=S.view(d,0);eq(view.daily.claimable,true);eq(view.premiumAvailable,false);eq(view.tiers[6].earned,true)
  view.daily.reward.Quantity=999;eq(S.view(d,0).daily.reward.Quantity,2)
  eq(view.season,nil);eq(view.daily.lastClaimDay,nil)
 end)
 test("disabled rewards make no changes",function()
  local c=Util.copy(Config);c.Enabled=false;local off=Make(Content,Util,Economy,c);local d=data();local old=Util.copy(d)
  eq(off.apply(d,"ClaimDailyReward",{},0,function()end),"LaunchRewardsUnavailable");eq(d,old);eq(off.view(d,0).available,false)
 end)
end

--!strict
local B=require("../src/server/Systems/BossPatterns")
return function(test: any,eq: any)
	local function boss(): any return {health=100,stats={MaxHealth=100,AttackInterval=3},root={Position={X=0,Y=2,Z=0}}} end
	local function target(x: number): any return {root={Position={X=x,Y=3,Z=0}}} end
	test("boss slam locks footprint and allows escape before impact",function()
		local a,t=boss(),target(10);local p=B.begin(a,t,0)
		eq(p.name,"Warden Slam");eq(p.radius,5);eq(B.take(a,1.19),nil)
		t.root.Position.X=20
		eq(B.contains(p,t.root.Position),false);eq(B.contains(p,{X=10,Y=3,Z=0}),true)
		eq(B.take(a,1.2),p);eq(B.take(a,1.2),nil);eq(a.nextAttack,4.2)
	end)
	test("boss recovery and pending cast cannot be bypassed",function()
		local a,t=boss(),target(0);local p=B.begin(a,t,0)
		eq(B.begin(a,t,1),nil);eq(a.pendingPattern,p)
		B.take(a,1.2);eq(B.begin(a,t,4.19),nil);assert(B.begin(a,t,4.2))
	end)
	test("half-health phase alternates pulse and slam with fixed boss origin",function()
		local a,t=boss(),target(20);a.health=50
		eq(B.begin(a,t,0).name,"Warden Slam");B.take(a,1.2)
		local p=B.begin(a,t,5);eq(p.name,"Warden Pulse");eq(p.duration,1.8);eq(p.radius,10);eq(p.x,0)
		a.root.Position.X=30;eq(p.x,0);B.take(a,7)
		eq(B.begin(a,t,10).name,"Warden Slam")
	end)
	test("boss circle boundary and height are bounded",function()
		local p=B.begin(boss(),target(0),0)
		eq(B.contains(p,{X=3,Y=3,Z=4}),true);eq(B.contains(p,{X=3.01,Y=3,Z=4}),false)
		eq(B.contains(p,{X=0,Y=11,Z=0}),true);eq(B.contains(p,{X=0,Y=11.01,Z=0}),false)
	end)
	test("leash or death cancellation cannot release a stale attack",function()
		local a,t=boss(),target(0);B.begin(a,t,0);B.cancel(a,.5)
		eq(B.take(a,2),nil);eq(B.begin(a,t,2),nil);eq(a.nextAttack,3.5)
		B.cancel(a,3);eq(a.nextAttack,3.5);a.health=0;eq(B.begin(a,t,4),nil)
	end)
	test("stalled boss attack expires once and preserves recovery",function()
		local a,t=boss(),target(0);local p=B.begin(a,t,10)
		eq(B.take(a,p.due+.501),nil);eq(a.pendingPattern,nil)
		eq(a.nextAttack,p.due+.501+3);eq(B.take(a,30),nil)
		eq(B.begin(a,t,p.due+1),nil)
	end)
	test("boss impact tolerates bounded scheduler jitter",function()
		local a,t=boss(),target(0);local p=B.begin(a,t,0)
		eq(B.take(a,p.due+.49),p);eq(B.take(a,p.due+.49),nil)
	end)
	test("dead boss cannot release even without explicit cancellation",function()
		local a,t=boss(),target(0);local p=B.begin(a,t,0);a.health=0
		eq(B.take(a,p.due),nil);eq(a.pendingPattern,nil)
	end)
end

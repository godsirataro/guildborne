--!strict
local M=require("../src/server/Systems/PlayerGuildMembership")
local R=require("../src/server/Systems/PlayerGuildRecovery")
return function(test:any,eq:any)
	test("player guild recovery advances only the durable handshake phase",function()
		local s=M.newSlot();M.reserve(s,"guild","founder")
		local g=M.newGuild("guild","1",s)
		eq(R.next(s,g,"1","Found"),"ActivateSlot")
		M.activateSlot(s,g,"1");eq(R.next(s,g,"1","Found"),"ActivateMember")
		M.activateMember(g,"1",s);eq(R.next(s,g,"1","Found"),"Ready")
		local before=s.state;R.next(s,g,"1","Found");eq(s.state,before)
	end)
	test("player guild failed reads never clear a membership reservation",function()
		local s=M.newSlot();M.reserve(s,"guild","join")
		for _,status in ipairs({"Timeout","Throttled","Unavailable"}) do eq(R.next(s,nil,"2",status),"RetryRead") end
		eq(R.next(s,nil,"2","Missing"),"InvestigateMissingGuild");eq(s.state,"Reserved")
		eq(R.next(M.newSlot(),nil,"2","Missing"),"Idle")
	end)
	test("player guild recovery finishes revocation without touching a newer guild",function()
		local s=M.newSlot();M.reserve(s,"guild","join")
		local g=M.newGuild("guild","2",s);M.abortJoin(g,"2",s,"cancel")
		eq(R.next(s,g,"2","Found"),"ClearSlot")
		M.clearSlot(s,g,"2");eq(R.next(s,g,"2","Found"),"FinishRemoval")
		M.reserve(s,"other","new");eq(R.next(s,g,"2","Found"),"FinishRemoval")
		M.finishRemoval(g,"2",s);eq(s.guildId,"other")
		eq(R.next(s,g,"2","Found"),"ReadCurrentGuild")
	end)
	test("player guild inconsistent active records are quarantined without inventing authority",function()
		local s=M.newSlot();M.reserve(s,"guild","join");local g=M.newGuild("guild","2",s)
		g.members['2'].operationId="different";eq(R.next(s,g,"2","Found"),"Quarantine")
		local other={state="Reserved",guildId="other",operationId="new",generation=2}
		eq(R.next(other,g,"2","Found"),"Quarantine")
		g.members['2']=nil;eq(R.next(s,g,"2","Found"),"ResumeOrCancelReservation")
		s.state="Active";eq(R.next(s,g,"2","Found"),"Quarantine")
		eq(R.next(s,{},"2","Found"),"Quarantine")
	end)
end

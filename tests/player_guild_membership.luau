--!strict
local M=require("../src/server/Systems/PlayerGuildMembership")
local function clone(t:any):any local c={};for k,v in pairs(t)do c[k]=if type(v)=="table"then clone(v)else v end;return c end
return function(test:any,eq:any)
 local function founded(gid:string,uid:string,capacity:number?):(any,any)
  local s=M.newSlot();assert(M.reserve(s,gid,"found:"..uid));local g=M.newGuild(gid,uid,s,capacity)
  assert(M.activateSlot(s,g,uid));assert(M.activateMember(g,uid,s));return g,s
 end
 local function join(g:any,leader:string,u:string):any
  local invite=M.invite(g,leader,u,100,300);assert(invite);local slot=M.newSlot();assert(M.reserve(slot,g.id,"join:"..u));assert(M.prepareJoin(g,u,invite.token,slot,101));assert(M.activateSlot(slot,g,u));assert(M.activateMember(g,u,slot));return slot
 end
 test("player guild founder handshake grants no authority before canonical activation",function()
  local s=M.newSlot();eq(M.reserve(s,"g1","op1"),true);local g=M.newGuild("g1","1",s)
  eq(M.can(g,"1","Invite"),false);eq(M.activateMember(g,"1",s),false)
  eq(M.activateSlot(s,g,"1"),true);eq(M.can(g,"1","Invite"),false)
  eq(M.activateMember(g,"1",s),true);eq(M.can(g,"1","Invite"),true)
  eq(M.activateSlot(s,g,"1"),true);eq(M.activateMember(g,"1",s),true)
 end)
 test("player guild membership slot rejects simultaneous guild invitations",function()
  local a=founded("a","1");local b=founded("b","2");local sa=M.newSlot()
  local ia=M.invite(a,"1","3",0,30);local ib=M.invite(b,"2","3",0,30);assert(ia and ib)
  eq(M.reserve(sa,"a","join-a"),true);eq(M.reserve(sa,"b","join-b"),false)
  eq(M.prepareJoin(b,"3",ib.token,sa,1),false);eq(M.prepareJoin(a,"3",ia.token,sa,1),true)
  eq(M.activateSlot(sa,a,"3"),true);eq(M.activateMember(a,"3",sa),true);eq(M.can(b,"3","Participate"),false)
 end)
 test("player guild partial joins survive record cloning and repeated phases",function()
  local g=founded("guild","1");local invite=M.invite(g,"1","2",10,300);assert(invite)
  local slot=M.newSlot();M.reserve(slot,g.id,"recover")
  for phase=1,3 do
   g=clone(g);slot=clone(slot)
   if phase==1 then eq(M.prepareJoin(g,"2",invite.token,slot,11),true);eq(M.prepareJoin(g,"2",invite.token,slot,11),true)
   elseif phase==2 then eq(M.activateSlot(slot,g,"2"),true);eq(M.can(g,"2","Participate"),false)
   else eq(M.activateMember(g,"2",slot),true);eq(M.activateMember(g,"2",slot),true)end
  end
  eq(M.can(g,"2","Participate"),true)
 end)
 test("player guild invitation targets expiry revoked officers and capacity are enforced",function()
  local g=founded("guild","1",3);join(g,"1","2");eq(M.setRole(g,"1","2","Officer"),true)
  local invite=M.invite(g,"2","3",1,5);assert(invite);local s=M.newSlot();M.reserve(s,g.id,"third")
  eq(M.prepareJoin(g,"4",invite.token,s,2),false);eq(M.prepareJoin(g,"3",invite.token,s,6),false)
  M.setRole(g,"1","2","Member");eq(M.prepareJoin(g,"3",invite.token,s,2),false)
  local other=M.invite(g,"1","4",1,10);assert(other);join(g,"1","3")
  local extra=M.newSlot();M.reserve(extra,g.id,"fourth");eq(M.prepareJoin(g,"4",other.token,extra,2),false)
 end)
 test("player guild role capabilities do not conflate commanders and officers",function()
  local g=founded("guild","1");join(g,"1","2");join(g,"1","3")
  eq(M.setRole(g,"1","2","Officer"),true);eq(M.setRole(g,"1","3","Commander"),true)
  eq(M.can(g,"2","Invite"),true);eq(M.can(g,"2","Command"),false)
  eq(M.can(g,"3","Command"),true);eq(M.can(g,"3","Invite"),false)
  eq(M.setRole(g,"2","3","Officer"),false);eq(M.setRole(g,"1","2","Master"),false)
  eq(M.can(g,"1","WithdrawTreasury"),false)
 end)
 test("player guild revocation precedes slot clearing and stale activation cannot restore rights",function()
  local g=founded("guild","1");local s=join(g,"1","2");local old=clone(s)
  eq(M.clearSlot(s,g,"2"),false);eq(M.revoke(g,"1","2","kick1"),true);eq(M.can(g,"2","Participate"),false)
  eq(M.activateMember(g,"2",old),false);eq(M.activateSlot(s,g,"2"),false)
  eq(M.finishRemoval(g,"2",s),false);eq(M.clearSlot(s,g,"2"),true)
  eq(M.reserve(s,"other","next"),true);eq(M.finishRemoval(g,"2",s),true);eq(M.finishRemoval(g,"2",s),true)
  eq(M.activateMember(g,"2",old),false);eq(s.guildId,"other")
 end)
 test("player guild officer cannot revoke peers or master while members can leave",function()
  local g=founded("guild","1");join(g,"1","2");join(g,"1","3");M.setRole(g,"1","2","Officer");M.setRole(g,"1","3","Officer")
  eq(M.revoke(g,"2","3","kick"),false);eq(M.revoke(g,"2","1","kick"),false)
  eq(M.revoke(g,"3","3","leave"),true);eq(M.revoke(g,"3","3","leave"),true);eq(M.revoke(g,"3","3","other"),false)
 end)
 test("player guild leadership requires recipient consent and rejects replaced expired offers",function()
  local g=founded("guild","1");join(g,"1","2");join(g,"1","3")
  local a=M.offerTransfer(g,"1","2",100);assert(a);eq(M.acceptTransfer(g,"3",a.token,101),false)
  local b=M.offerTransfer(g,"1","3",101);assert(b);eq(M.acceptTransfer(g,"2",a.token,102),false)
  eq(M.acceptTransfer(g,"3",b.token,401),false)
  local c=M.offerTransfer(g,"1","2",500);assert(c);eq(M.acceptTransfer(g,"2",c.token,501),true)
  eq(g.leader,"2");eq(g.members['1'].role,"Officer");eq(g.members['2'].role,"Master");eq(M.acceptTransfer(g,"2",c.token,502),false)
 end)
 test("player guild pending join can be abandoned without activating or leaking the slot",function()
  local g=founded("guild","1");local invite=M.invite(g,"1","2",0,30);assert(invite)
  local s=M.newSlot();M.reserve(s,g.id,"pending");M.prepareJoin(g,"2",invite.token,s,1)
  eq(M.abortJoin(g,"2",s,"cancel"),true);eq(M.activateMember(g,"2",s),false)
  eq(M.clearSlot(s,g,"2"),true);eq(M.finishRemoval(g,"2",s),true);eq(s.state,"Empty")
 end)
 test("player guild consumed generations cannot rejoin using delayed old proofs",function()
  local g=founded("guild","1");local s=join(g,"1","2");local stale=clone(s);stale.state="Reserved"
  M.revoke(g,"1","2","remove");M.clearSlot(s,g,"2");M.finishRemoval(g,"2",s)
  local invite=M.invite(g,"1","2",200,300);assert(invite)
  eq(M.prepareJoin(g,"2",invite.token,stale,201),false)
  eq(M.reserve(s,g.id,"new-join"),true);eq(M.prepareJoin(g,"2",invite.token,s,201),true)
  eq(M.activateMember(g,"2",stale),false);eq(M.activateSlot(s,g,"2"),true);eq(M.activateMember(g,"2",s),true)
 end)
 test("player guild failed invitation reservation can be cancelled before a member exists",function()
  local g=founded("guild","1");local s=M.newSlot();M.reserve(s,g.id,"expired")
  local stale=clone(s);eq(M.abortJoin(g,"2",s,"cancel"),true);eq(M.clearSlot(s,g,"2"),true);eq(M.finishRemoval(g,"2",s),true)
  local invite=M.invite(g,"1","2",10,100);assert(invite)
  eq(M.prepareJoin(g,"2",invite.token,stale,11),false);eq(s.state,"Empty")
  eq(M.invite(g,"1","02",10,100),nil)
 end)
end
